DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=grit_wheel
CORS_ORIGIN=http://localhost:4200

# Public URL of the frontend. Used to send people back to the app after Google
# sign-in, and to derive GOOGLE_REDIRECT_URI when that isn't set explicitly.
FRONTEND_URL=http://localhost:4200

# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of @bitwarden.com emails that should have admin access
# (create rounds, spin the wheel, view analytics).
ADMIN_EMAILS=admin@bitwarden.com

# Set to "true" only if the site is served over HTTPS (recommended in production).
COOKIE_SECURE=false

# Google OAuth credentials from the Google Cloud console (APIs & Services ->
# Credentials -> OAuth 2.0 Client IDs -> Web application). Signing in with Google
# is the only way into the app, so both of these are required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match one of the "Authorized redirect URIs" on that OAuth client.
# Defaults to "<FRONTEND_URL>/api/auth/google/callback" if left blank.
GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback

# Optional: paste a Slack "Incoming Webhook" URL to post nomination/round/winner
# updates to a channel. Leave blank to disable Slack notifications.
SLACK_WEBHOOK_URL=
