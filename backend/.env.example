PORT=3000
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=grit_wheel
CORS_ORIGIN=http://localhost:4200

# Public URL of the frontend, used to build the link inside magic-link emails.
FRONTEND_URL=http://localhost:4200

# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of @bitwarden.com emails that should have admin access
# (create rounds, spin the wheel, manage photos, view analytics).
ADMIN_EMAILS=admin@bitwarden.com

# Set to "true" only if the site is served over HTTPS (recommended in production).
COOKIE_SECURE=false

# SMTP settings used to send magic-link sign-in emails. If left blank, the
# magic link is logged to the backend console instead of being emailed
# (handy for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Bitwarden GRIT Award <no-reply@bitwarden.com>"

# Optional: paste a Slack "Incoming Webhook" URL to post nomination/round/winner
# updates to a channel. Leave blank to disable Slack notifications.
SLACK_WEBHOOK_URL=
