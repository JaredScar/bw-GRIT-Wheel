# Template for the .env that lives next to docker-compose.prod.yml on the VM
# (/opt/grit/.env). Copy it there, fill in real values, and never commit the
# result — this repository is public.
#
#   cp .env.production.example .env

# --- Images -----------------------------------------------------------------
# Artifact Registry path, without the :tag. CI pushes <IMAGE_REPO>/backend and
# <IMAGE_REPO>/frontend, and the deploy step rewrites IMAGE_TAG in place.
IMAGE_REPO=us-central1-docker.pkg.dev/bitwarden-grit/grit
IMAGE_TAG=v1.0.0

# --- Public address ---------------------------------------------------------
# The hostname Caddy should serve and obtain a certificate for. DNS must already
# point at this VM. Use ":80" to serve plain HTTP while you are still waiting on
# DNS — the app will load, but Google sign-in will not work over HTTP.
SITE_ADDRESS=grit.example.com

# Must match SITE_ADDRESS, with the scheme. People are sent back here after
# signing in with Google, and it doubles as the CORS allow-list.
FRONTEND_URL=https://grit.example.com

# --- Database ---------------------------------------------------------------
DB_USER=postgres
DB_NAME=grit_wheel
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=

# --- Session ----------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value from the one in local development.
JWT_SECRET=

# Comma-separated @bitwarden.com emails allowed to create rounds, spin the
# wheel, and view analytics. An empty value means nobody can.
ADMIN_EMAILS=

# Compared against the literal string "true". Leave it alone unless you are
# deliberately testing over plain HTTP, where a Secure cookie would be dropped.
COOKIE_SECURE=true

# --- Google OAuth -----------------------------------------------------------
# APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web application.
# Add https://<your-host>/api/auth/google/callback to that client's Authorized
# redirect URIs before deploying.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave blank to derive <FRONTEND_URL>/api/auth/google/callback automatically.
GOOGLE_REDIRECT_URI=

# --- Optional ---------------------------------------------------------------
# Slack incoming webhook for nomination/round/winner notifications. Blank
# disables Slack entirely.
SLACK_WEBHOOK_URL=
